# ============================================================
# InvariantX — Environment Configuration
# ============================================================

# Groq
# Create your own API key and keep the real value only in .env.local.
GROQ_API_KEY=your_groq_api_key_here

# Model used by InvariantX AI reasoning modules.
GROQ_MODEL=openai/gpt-oss-120b

# ============================================================
# Database
# ============================================================

# Local SQLite database used by the hackathon prototype.
DATABASE_PATH=./data/invariantx.db